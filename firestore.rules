rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function family() {
      return request.auth != null
        && request.auth.token.email in [
          'ضع-ايميلك@gmail.com',
          'ايميل-الاخ@gmail.com',
          'ايميل-الاب@gmail.com',
          'ايميل-الام@gmail.com'
        ];
    }
    match /{document=**} {
      allow read, write: if family();
    }
  }
}
